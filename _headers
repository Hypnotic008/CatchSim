# Netlify response headers. This file must sit at the publish root.
# Explicit types and range support so browsers stream and seek the video
# instead of downloading it as an unknown file.
/*.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.pdf
  Content-Type: application/pdf
  Content-Disposition: inline; filename="Dalen_Wagga_Resume.pdf"

/*.csv
  Content-Type: text/csv; charset=utf-8
